VITE_API_BASE_URL=https://hiring-dev.internal.kloudspot.com

# Socket.IO - by default the same host as the API. Only set these if the socket lives elsewhere.
# VITE_SOCKET_URL=https://hiring-dev.internal.kloudspot.com
# VITE_SOCKET_PATH=/socket.io
# Print the first raw socket payloads in the console (always on in `npm run dev`)
# VITE_SOCKET_DEBUG=true
